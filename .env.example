# Querent (BOXT quote tool) environment. Copy this file to .env.local (git-ignored; the only real env
# file) and fill it in. Next.js and the scripts read .env.local; a variable already set in the shell wins.
# Placeholders only: never commit a real key here.
# TODO(R-2): move API keys from .env.local to user secrets or a secrets manager.

# Supabase project URL and anon (public) key, used by the app. Local stack: http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. Scripts only (seed, local reset); the app never reads it.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for migrations and the seed. Local stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Claude API key for parsing lists and judging matches. Empty = scripted (fixture) parser and judge.
ANTHROPIC_API_KEY=
# Claude model for the parser and the judge. Empty = the default in src/server/llm/client.ts.
ANTHROPIC_MODEL=
# 1 = fixture parser and judge, never the network, even with a key.
QUERENT_SCRIPTED=
# Port for npm start.
PORT=3000
