# Querent environment. Copy this file to .env.local (git-ignored; the only real env file) and fill it in.
# Next.js and `npm run db:reset` read .env.local; a variable already set in the shell wins.
# Placeholders only: never commit a real key here.
# TODO(R-2): move API keys from .env.local to user secrets or a secrets manager.

# Claude API key. Empty = scripted chat (offline, deterministic).
ANTHROPIC_API_KEY=
# Live chat and chip-writer model. Empty = claude-sonnet-5.
ANTHROPIC_MODEL=
# The SQLite file. On Railway use /data/querent.sqlite.
DATABASE_PATH=./data/querent.sqlite
# OilPriceAPI key for the daily state gasoline price (Pricing & Delivery). Empty = manual fuel price only.
OILPRICEAPI_KEY=
# Seed date (YYYY-MM-DD) for db:reset and first-open seeding. Empty = yesterday (UTC); 2026-09-23 matches the mockup.
QUERENT_SEED_DATE=
# 1 forces scripted chat even with a key.
QUERENT_SCRIPTED=
# Tests only: 1 enables POST /api/test/*. Never set it on a shared deployment.
QUERENT_E2E_RESET=
# Port for npm start.
PORT=3000
